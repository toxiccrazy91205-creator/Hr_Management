# ═══════════════════════════════════════════════════════════
# HR Agentic AI Recruitment System — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.

# ── Django ────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ── OpenRouter / NVIDIA NIM API ───────────────────────────
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# For NVIDIA NIM, use:
# OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_MODEL=meta/llama-3.1-8b-instruct

# ── ChromaDB ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=hr_resumes

# ── Email ─────────────────────────────────────────────────
# Default: console backend (prints to terminal, no actual sending)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For real SMTP (e.g., Gmail):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com
